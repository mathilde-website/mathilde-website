{
  extends: ["config:recommended", ":enablePreCommit", "helpers:pinGitHubActionDigests"],
  schedule: ["* * 7 * *"],
  labels: ["deps"],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^content/admin/index\\.html$/"],
      matchStrings: ["unpkg\\.com/(?<depName>decap-cms)@(?<currentValue>[^/]+)/"],
      datasourceTemplate: "npm",
    },
  ],
  packageRules: [
    {
      groupName: "all dependencies",
      groupSlug: "all",
      matchPackageNames: ["*"],
    },
  ],
  automerge: true,
}
